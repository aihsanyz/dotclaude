# Whitelist: ignore everything, then allow only shareable configuration.
# Never un-ignore .credentials.json, projects/, sessions/, caches, plugins/ or local.md.
*

!.gitignore
!README.md
!CLAUDE.md
!local.example.md
!settings.json

!agents/
!agents/*.md

!hooks/
!hooks/*.py

!scripts/
!scripts/*.sh

!skills/
!skills/tasker/
!skills/tasker/SKILL.md
!skills/push/
!skills/push/SKILL.md
!skills/merge/
!skills/merge/SKILL.md
!skills/release/
!skills/release/SKILL.md
!skills/dev-env/
!skills/dev-env/SKILL.md
!skills/initer/
!skills/initer/SKILL.md


# Whitelist: ignore everything, then allow only shareable configuration.
# Never un-ignore .credentials.json, projects/, sessions/, caches, plugins/ or local.md.
*

!.gitignore
!README.md
!CLAUDE.md
!SOURCES.md
!local.example.md
!settings.json

!rules/
!rules/*.md

!agents/
!agents/*.md

!hooks/
!hooks/*.py

!scripts/
!scripts/*.sh
!scripts/*.py

!templates/
!templates/**

!skills/
!skills/*/
!skills/*/**
skills/.trash/
skills/synced/

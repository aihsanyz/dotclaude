{
  "theme": "auto",
  "language": "turkish",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/guard_git.py\"",
            "timeout": 30,
            "statusMessage": "Checking git guard"
          }
        ]
      }
    ]
  }
}
